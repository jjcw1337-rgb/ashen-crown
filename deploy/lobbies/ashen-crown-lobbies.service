[Unit]
Description=Ashen Crown on-demand multiplayer lobbies
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ashen
Group=ashen
WorkingDirectory=/opt/ashen-crown/staging/game
EnvironmentFile=/opt/ashen-crown/staging/bg.env
# Deploy CI-exported Linux executable/PCK here. Never import on the live host.
EnvironmentFile=/opt/ashen-crown/staging/lobbies.env
ExecStart=/usr/bin/python3 /opt/ashen-crown/staging/game/deploy/lobbies/service.py --state /var/lib/ashen-lobbies --game /opt/ashen-crown/staging/game --godot /opt/ashen-crown/staging/game/AshenCrown.x86_64 --proxy-bind ${LOBBY_PROXY_BIND} --public-host 161.35.185.195 --first-port 24600 --slots 1 --min-free-mb 1500
StateDirectory=ashen-lobbies
UMask=0077
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
MemoryHigh=1400M
MemoryMax=1800M
MemorySwapMax=256M
CPUQuota=150%
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
