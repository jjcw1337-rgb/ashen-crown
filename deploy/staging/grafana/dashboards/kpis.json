   },
   "options": {
    "mode": "markdown",
    "content": "**Ashen Crown performance KPIs.** Fixed scripted scenarios (`scripts/kpi.gd`) measured on the Game Factory Mac (Apple M6, 1600x900 window) around every nightly job; definitions and targets: `docs/systems/performance_kpis.md`. Targets: **60 fps average, 45 fps 1% low, 0 hitches, under 3 s loads, a download under 200 MB.** `phase` before = staging as it stood when a job started; after = that job's result."
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Average fps now",
   "description": "The latest average frames per second of each scenario. Target 60.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "kpi-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "kpi-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT DISTINCT ON (scenario) ts AS time, scenario AS metric, value FROM kpi WHERE metric = 'fps_avg' AND preset = $preset AND scenario <> 'server' AND source = '$source' ORDER BY scenario, ts DESC"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "horizontal"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 30
       },
       {
        "color": "green",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   }
  },
