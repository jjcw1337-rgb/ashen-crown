# HTTPS in front of Nakama's API (STAGING). The site is the server's public IP ({$STAGING_HOST}): Let's Encrypt
# issues certificates for IP addresses on its short-lived profile (6-day certificates, renewed by Caddy on its own).
# Ports 80 (ACME challenge, redirects) and 443. Nakama itself listens on the server's loopback only.
https://{$STAGING_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	reverse_proxy nakama:7350
}
