<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The nightly lab (docs/nightly/README.md): 03:00 every day, Mac local time (America/New_York).
     Install: cp to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that path>`.
     If the Mac was asleep at 03:00, launchd runs it once when it wakes. Run now: `launchctl kickstart gui/$(id -u)/com.gamefactory.ashen-nightly`.
     It runs the copy in ~/dev/ashen-crown-nightly-runner (tools/nightly/install.sh keeps it), so a run never edits
     the script it is running. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gamefactory.ashen-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/blaine/dev/ashen-crown-nightly-runner/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/blaine/Library/Logs/ashen-nightly/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/blaine/Library/Logs/ashen-nightly/launchd.log</string>
  <key>ProcessType</key><string>Standard</string>
  <key>LowPriorityIO</key><false/>
</dict>
</plist>
