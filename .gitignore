# Godot's import cache and editor state (rebuilt automatically when the project is opened)
.godot/
# Exported builds (GitHub Actions makes these on every push)
/build/
*.zip
# Godot's import files for models, and the textures it extracts from them (regenerated on import)
assets/models/*.import
assets/models/*_Image_*
assets/models/*_normal.jpg
assets/models/*_basecolor.jpg
# Editor / OS clutter
.DS_Store
Thumbs.db
*.tmp
assets/models/**/*.import
assets/models/**/*_Image_*
assets/models/**/*_normal.jpg
assets/models/**/*_normal_*.jpg
# textures Godot extracts from the re-baked set pieces (tools/blender/camp/rebake_prop.py)
assets/models/**/*_albedo.jpg
assets/models/**/*_metal_rough.jpg
assets/models/**/*_normal.png
assets/models/**/*_emission.jpg
# ... and from the brazier coals library (tools/blender/waypoint/rock_library.py): its AO/roughness and glow masks are PNG
assets/models/**/*_metal_rough.png
assets/models/**/*_glow.png
__pycache__/
assets/models/monsters/feral*_*.jpg

# admin keys never go in the repo (AdminKey)
*.pem
admin.key
waveletNoiseTile.bin
assets/models/**/*_Material_*_baseColor.jpg
assets/models/**/*_Material_*_metallic-*.jpg
assets/models/**/*_Material_*_normal.jpg
server/

# hero folders (heroes/<name>/): Godot's import files for their models and the textures it extracts, like assets/models/
heroes/**/*.glb.import
heroes/**/*_Image_*
heroes/**/*_normal.jpg
heroes/**/*_normal_*.jpg
heroes/**/*_albedo.jpg
heroes/**/*_metal_rough.jpg
heroes/**/*_emission.jpg
