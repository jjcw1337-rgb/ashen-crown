# Godot's import cache and editor state (rebuilt automatically when the project is opened)
.godot/
# Exported builds (GitHub Actions makes these on every push)
/build/
*.zip
# Godot's import files for models, and the textures it extracts from them (regenerated on import)
assets/models/*.import
assets/models/*_Image_*
assets/models/*_normal.jpg
assets/models/*_basecolor.jpg
# Editor / OS clutter
.DS_Store
Thumbs.db
*.tmp
assets/models/**/*.import
assets/models/**/*_Image_*
assets/models/**/*_normal.jpg
assets/models/**/*_normal_*.jpg
# textures Godot extracts from the re-baked set pieces (tools/blender/camp/rebake_prop.py)
assets/models/**/*_albedo.jpg
assets/models/**/*_metal_rough.jpg
assets/models/**/*_normal.png
assets/models/**/*_emission.jpg
# ... and from the brazier coals library (tools/blender/waypoint/rock_library.py): its AO/roughness and glow masks are PNG
assets/models/**/*_metal_rough.png
assets/models/**/*_glow.png
__pycache__/
assets/models/monsters/feral*_*.jpg

# admin keys never go in the repo (AdminKey)
*.pem
admin.key
waveletNoiseTile.bin
assets/models/**/*_Material_*_baseColor.jpg
assets/models/**/*_Material_*_metallic-*.jpg
assets/models/**/*_Material_*_normal.jpg
server/

# hero folders (game/heroes/<name>/): Godot's import files for their models and the textures it extracts, like assets/models/
game/heroes/**/*.glb.import
game/heroes/**/*_Image_*
game/heroes/**/*_normal.jpg
game/heroes/**/*_normal_*.jpg
game/heroes/**/*_albedo.jpg
game/heroes/**/*_metal_rough.jpg
game/heroes/**/*_emission.jpg
game/heroes/**/*_normal.jpg.import
game/heroes/**/*_normal_*.jpg.import
game/heroes/**/*_albedo.jpg.import
game/heroes/**/*_metal_rough.jpg.import
game/heroes/**/*_emission.jpg.import
game/heroes/**/*_Material_*

# map folders (game/maps/<name>/): Godot's import files for their models and the textures it extracts (props/), like heroes/
game/maps/**/*.glb.import
game/maps/**/props/*_Image_*
game/maps/**/props/*_albedo.jpg*
game/maps/**/props/*_metal_rough.jpg*
game/maps/**/props/*_normal.png*
game/maps/**/props/*_normal.jpg*
game/maps/**/props/*_emission.jpg*
game/maps/**/props/*_Material_*

# monster folders (game/monsters/<name>/): Godot's import files for their models and the textures it extracts
game/monsters/**/*.glb.import
game/monsters/**/*_Image_*
game/monsters/**/*_normal.jpg*
game/monsters/**/*_albedo.jpg*
game/monsters/**/*_metal_rough.jpg*
game/monsters/**/*_emission.jpg*
game/monsters/**/*_Material_*
