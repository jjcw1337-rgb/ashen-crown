class_name KnightBody
extends RefCounted
## The Knight's own bodies (docs/content/heroes.md). In play he is the armoured crusader on the motion-captured
## skeleton (knight_mocap.glb, built by the shared Knight.build_mocap: game/systems/bodies/knight.gd); with no armour on,
## the Meshy body in shirt and shorts (knight_meshy.glb); without the mocap model, the Meshy plate (knight_armored.glb);
## without any (a headless server), the shared procedural body (Knight.build). Their Blender prep is build/.

const MOCAP_GLB := "res://game/heroes/knight/body/knight_mocap.glb"
const ARMORED_GLB := "res://game/heroes/knight/body/knight_armored.glb"

## The knight with no armour on: a model generated with Meshy (white shirt, white shorts, long
## hair), rigged in Blender by build/rig_meshy_knight.py on this joint layout
## (Godot axes, model faces -z). hair1/hair2 are sway bones driven by knight_rig.gd.
const MESHY_GLB := "res://game/heroes/knight/body/knight_meshy.glb"
# meshy layout begin (generated by game/heroes/knight/build/layout_to_gd.py)
const MESHY_LAYOUT := {
	"hips": ["", Vector3(0.0, 0.95, 0.0)],
	"torso": ["hips", Vector3(0.0, 1.03, 0.0)],
	"sh_r": ["torso", Vector3(0.18, 1.53, 0.0)],
	"el_r": ["sh_r", Vector3(0.18, 1.2103, 0.0)],
	"hand_r": ["el_r", Vector3(0.18, 0.9394, 0.0)],
	"leg_r": ["hips", Vector3(0.09, 0.9, 0.0)],
	"knee_r": ["leg_r", Vector3(0.09, 0.4675, 0.0)],
	"sh_l": ["torso", Vector3(-0.18, 1.53, 0.0)],
	"el_l": ["sh_l", Vector3(-0.18, 1.2103, 0.0)],
	"hand_l": ["el_l", Vector3(-0.18, 0.9394, 0.0)],
	"leg_l": ["hips", Vector3(-0.09, 0.9, 0.0)],
	"knee_l": ["leg_l", Vector3(-0.09, 0.4675, 0.0)],
	"head": ["torso", Vector3(0.0, 1.64, -0.005)],
	"hA1": ["head", Vector3(-0.1091, 1.6592, -0.0439)],
	"hA2": ["hA1", Vector3(-0.1192, 1.5582, -0.0796)],
	"hA3": ["hA2", Vector3(-0.0982, 1.465, -0.1505)],
	"hB1": ["head", Vector3(-0.0977, 1.6597, 0.0739)],
	"hB2": ["hB1", Vector3(-0.1223, 1.564, 0.12)],
	"hB3": ["hB2", Vector3(-0.0985, 1.4701, 0.1501)],
	"hC1": ["head", Vector3(0.0007, 1.6566, 0.1131)],
	"hC2": ["hC1", Vector3(-0.0013, 1.5592, 0.155)],
	"hC3": ["hC2", Vector3(0.002, 1.4666, 0.1645)],
	"hD1": ["head", Vector3(0.1038, 1.6598, 0.0666)],
	"hD2": ["hD1", Vector3(0.12, 1.5646, 0.1183)],
	"hD3": ["hD2", Vector3(0.0982, 1.4705, 0.1501)],
	"hE1": ["head", Vector3(0.1118, 1.6594, -0.0412)],
	"hE2": ["hE1", Vector3(0.1205, 1.5595, -0.0796)],
	"hE3": ["hE2", Vector3(0.0912, 1.4669, -0.1473)],
}
const MESHY_BONES := ["hips", "torso", "sh_r", "el_r", "hand_r", "leg_r", "knee_r", "sh_l", "el_l", "hand_l", "leg_l", "knee_l", "head", "hA1", "hA2", "hA3", "hB1", "hB2", "hB3", "hC1", "hC2", "hC3", "hD1", "hD2", "hD3", "hE1", "hE2", "hE3"]
# meshy layout end

## glb path -> [ArrayMesh, Skin], built once per model.
static var _meshy_cache := {}

static func mocap_ok() -> bool:
	return not Knight.ARMORED_BONES.is_empty() and ResourceLoader.exists(MOCAP_GLB)

static func meshy_ok() -> bool:
	return ResourceLoader.exists(MESHY_GLB)

static func armored_ok() -> bool:
	return not Knight.ARMORED_BONES.is_empty() and ResourceLoader.exists(ARMORED_GLB)

## The crusader on his motion-captured body (the default options: his clips, his cloak).
static func build_mocap() -> Node3D:
	return Knight.build_mocap(MOCAP_GLB)

## One of the Meshy bodies: the plain one (shirt and shorts) or, with armored, the plate.
static func build_meshy(armored := false) -> Node3D:
	var GLB: String = ARMORED_GLB if armored else MESHY_GLB
	var LAYOUT: Dictionary = Knight.ARMORED_LAYOUT if armored else MESHY_LAYOUT
	var BONES: Array = Knight.ARMORED_BONES if armored else MESHY_BONES
	var root := Node3D.new()
	root.name = "Rig"
	root.set_script(load("res://game/systems/bodies/knight_rig.gd"))
	var J := {}
	for n in BONES:
		var par: String = LAYOUT[n][0]
		var at: Vector3 = LAYOUT[n][1]
		var base := Vector3.ZERO if par == "" else (LAYOUT[par][1] as Vector3)
		var nd := Node3D.new()
		nd.name = n
		nd.position = at - base
		(J[par] as Node3D if par != "" else root).add_child(nd)
		J[n] = nd
	J["hips_y"] = (LAYOUT["hips"][1] as Vector3).y
	J["grip_r"] = Models.N(J["hand_r"], "grip_r", Vector3(0, -0.07, -0.005), Vector3(-28, 0, 0))
	J["grip_l"] = Models.N(J["hand_l"], "grip_l", Vector3(0, -0.07, 0))
	J["mount_l"] = Models.N(J["el_l"], "mount_l", Vector3(-0.075, -0.14, 0), Vector3(0, 70, 0))
	var skel := Skeleton3D.new()
	skel.name = "Skeleton"
	root.add_child(skel)
	var bi := {}
	for i in BONES.size():
		skel.add_bone(BONES[i])
		bi[BONES[i]] = i
	var proxies := {}
	for i in BONES.size():
		var n: Node3D = J[BONES[i]]
		var par := n.get_parent()
		if par != root:
			skel.set_bone_parent(i, bi[String(par.name)])
		skel.set_bone_rest(i, n.transform)
		skel.set_bone_pose_position(i, n.position)
		if not Knight._is_hair(BONES[i]):
			proxies[i] = n
	if not _meshy_cache.has(GLB):
		_meshy_cache[GLB] = [Goblin._imported(GLB, bi), skel.create_skin_from_rest_transforms()]
	var mi := MeshInstance3D.new()
	mi.name = "Body"
	mi.mesh = _meshy_cache[GLB][0]
	mi.skin = _meshy_cache[GLB][1]
	skel.add_child(mi)
	mi.skeleton = NodePath("..")
	root.set("skel", skel)
	root.set("proxy_of", proxies)
	# hair locks: chains of three bones (hA1..hA3, hB1..), simulated by knight_rig.gd
	var hb := []
	var hr := []
	var hk := []
	for n in BONES:
		if Knight._is_hair(n):
			hb.append(bi[n])
			hr.append((J[n] as Node3D).position)
			hk.append([String(n).unicode_at(1) - 65, String(n).right(1).to_int() - 1])
	root.set("hair_bones", hb)
	root.set("hair_rest", hr)
	root.set("hair_key", hk)
	root.set("head_bone", bi["head"])
	root.set_meta("j", J)
	root.set_meta("h", 1.0)
	root.set_meta("knight", true)
	root.set_meta("meshy", "armored" if armored else "plain")
	if armored:
		root.set_meta("elbow_out", 0.4)    # the plate is wide already: a tighter arm pump
	return root

## Sits a helm model on the knight's head joint (each body's head joint and skull differ).
static func fit_helm(hm: Node3D, r: Node3D) -> void:
	match str(r.get_meta("meshy")) if r.has_meta("meshy") else "":
		"armored", "mocap":
			hm.position = Vector3(0, 0.095, -0.06)
			hm.scale = Vector3(1.32, 1.32, 1.36)
		_:
			hm.position = Vector3(0, 0.092, 0.006)
			hm.scale = Vector3(1.04, 1.04, 1.04)
